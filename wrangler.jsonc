{
  "name": "beto-todo",
  "main": "src/worker_beto_todo.js",
  "workers_dev": true,
  "preview_urls": true,
  "compatibility_date": "2025-01-01",
  "keep_vars": true,
  "vars": { "COBRO_SOLO": "buentaco", "MP_APP_ID": "7526447272444426", "MP_PKCE": "si" },
  "triggers": { "crons": ["0 15 * * *"] },
  "routes": [
    {
      "pattern": "lacartamenu.com/*",
      "zone_name": "lacartamenu.com"
    },
    {
      "pattern": "*.lacartamenu.com/*",
      "zone_name": "lacartamenu.com"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FOTOS",
      "bucket_name": "beto-tickets"
    }
  ]
}